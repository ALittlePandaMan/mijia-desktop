{
  "name": "mijia-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "source:check": "node scripts/check-source.mjs",
    "version:set": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "licenses": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "echarts": "6.1.0",
    "mpegts.js": "1.8.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "jsqr": "1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
