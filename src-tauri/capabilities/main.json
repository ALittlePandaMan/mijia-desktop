{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local desktop window; cloud requests and credentials stay in Rust.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-set-fullscreen", "core:window:allow-set-theme", "core:window:allow-set-background-color", "core:window:allow-show"]
}
